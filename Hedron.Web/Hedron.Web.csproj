<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Hedron.Web</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!--
      References the telnet Server project for the shared engine composition root
      (CompositionRoot.Register) and the bootstrap hosted-service types
      (WorldContentBootstrap, RegistryValidationBootstrap) this host composes.
      Server transitively brings in Core. The web host adds the Blazor Server stack;
      Server stays a plain headless Exe with no web dependency.
    -->
    <ProjectReference Include="..\Server\Server.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Content Update="appsettings.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

</Project>
