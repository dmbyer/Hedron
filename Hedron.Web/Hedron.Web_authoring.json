{
  "openapi": "3.0.1",
  "info": {
    "title": "Hedron authoring API",
    "description": "Loopback-only, unauthenticated JSON surface over the content-definition catalog. Scoped to the operations the client-tier bakeoff page calls.",
    "version": "v1"
  },
  "paths": {
    "/api/areas": {
      "get": {
        "tags": [
          "Hedron.Web"
        ],
        "operationId": "ListAreaDefinitions",
        "parameters": [
          {
            "name": "area",
            "in": "query",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/ContentSummary"
                  }
                }
              }
            }
          },
          "403": {
            "description": "Forbidden",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "415": {
            "description": "Unsupported Media Type",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      }
    },
