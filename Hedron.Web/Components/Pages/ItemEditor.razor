@page "/item/new"
@page "/item/{BlueprintId}"
@using System.Linq
@using Hedron.Core
@using Hedron.Core.ECS.Components
@using Hedron.Core.Modules.BalanceInspection
@using Hedron.Core.Modules.BalanceInspection.Standards
@using Hedron.Core.Modules.Items.Systems
@using Hedron.Core.Modules.Items.Templates
@using Hedron.Core.Modules.Stats
@using Hedron.Core.Systems
@inject IContentDefinitionCatalog Catalog
@inject NavigationManager Nav
@inject IPowerBudgetSystem PowerBudget
@inject IBalanceStandardsRegistry StandardsRegistry
@inject IItemPowerProjectionSystem ItemProjection

<PageTitle>@(IsNew ? "New item" : "Edit item")</PageTitle>

<h1>@(IsNew ? "New item" : "Edit item")</h1>

@if (_notFound)
{
    <p class="error">No item definition with id <span class="mono">@BlueprintId</span> was found.</p>
    <a href="">Back to browser</a>
}
else if (_template is not null)
{
<div class="editor-form" @onkeydown="OnFormKeyDown">
    <BlueprintIdField Kind="ContentKind.Item" IsNew="IsNew" BlueprintId="@_template.BlueprintId"
                       BlueprintIdChanged="OnBlueprintIdChanged" OnRenamed="OnRenamed" />

    <div class="field">
        <label>Name</label>
        <input @ref="_firstField" @bind="_template.Name" />
    </div>

    <div class="field">
        <label>Description</label>
        <textarea rows="4" @bind="_template.Description" @onkeydown:stopPropagation="true"></textarea>
    </div>

    <div class="field-row">
        <div class="field">
            <label>Item type</label>
            <select @bind="_template.ItemType">
                @foreach (var type in AllItemTypes)
                {
                    <option value="@type">@type</option>
                }
            </select>
        </div>
        <div class="field">
            <label>Value <span class="hint-inline">(base-unit Coin; 0 = non-saleable)</span></label>
            <input type="number" min="0" @bind="_template.Value" />
        </div>
    </div>

    <fieldset class="stat-bonuses">
        <legend>Worn stat bonuses</legend>
        <p class="hint">Applied while the item is worn (derived on read). A negative magnitude is allowed for cursed gear.</p>
        @for (var i = 0; i < _template.StatBonuses.Count; i++)
        {
            var index = i;
            <div class="field-row stat-bonus-row" @key="index">
                <select value="@_template.StatBonuses[index].TargetScore"
                        @onchange="e => SetBonusScore(index, e.Value?.ToString())">
                    @foreach (var score in AllScoreIds)
                    {
                        <option value="@score">@score</option>
                    }
                </select>
                <input type="number" value="@_template.StatBonuses[index].Magnitude"
                       @onchange="e => SetBonusMagnitude(index, e.Value?.ToString())" />
                <button type="button" @onclick="() => RemoveBonus(index)">Remove</button>
            </div>
        }
        <button type="button" @onclick="AddBonus">Add bonus</button>
    </fieldset>

    <fieldset class="spawn-location">
        <legend>Spawn location</legend>
        <p class="hint">Select an area to narrow the room list, then pick the spawn room.</p>
        <div class="field-row">
            <div class="field">
                <label>Area</label>
                <select value="@_spawnAreaFilter" @onchange="e => SetSpawnAreaFilter(e.Value?.ToString())">
                    <option value="">All areas</option>
                    @foreach (var area in _areas)
                    {
                        <option @key="area.BlueprintId" value="@area.BlueprintId">@area.Name</option>
                    }
                </select>
            </div>
            <div class="field">
                <label>Room <span class="hint-inline">(blank = no spawn location)</span></label>
                <select value="@_template.SpawnRoomBlueprintId"
                        @onchange="e => _template.SpawnRoomBlueprintId = e.Value?.ToString() ?? string.Empty">
                    <option value="">-- no spawn room --</option>
                    @foreach (var room in SpawnRooms)
                    {
                        <option @key="room.BlueprintId" value="@room.BlueprintId">@room.Name (@room.BlueprintId)</option>
                    }
                </select>
            </div>
        </div>
    </fieldset>

    <fieldset class="keywords">
        <legend>Keywords</legend>
        <p class="hint">Comma-separated keyword aliases used to reference the item in game.</p>
        <input class="csv" placeholder="sword, blade, weapon"
               value="@string.Join(", ", _template.Keywords)"
               @onchange="e => SetKeywords(e.Value?.ToString())" />
    </fieldset>

    <fieldset class="worn-slots">
        <legend>Worn slots</legend>
        <p class="hint">Slots this item occupies when worn. Leave all unchecked for a non-wearable item.</p>
        @foreach (var slot in AllWornSlots)
        {
            <label class="checkbox">
                <input type="checkbox" checked="@_template.WornSlots.Contains(slot)"
                       @onchange="e => SetWornSlot(slot, (bool?)e.Value ?? false)" />
                @slot
            </label>
        }
    </fieldset>

    <fieldset class="ascension">
        <legend>Ascension</legend>
        <p class="hint">Tier (0-6, mechanical Ascension scalar) &times; Band (0-3, purely descriptive; 0 = unbanded/default). Mechanical threat is emergent from the tier baseline &mdash; Band is a content tag, not a power multiplier.</p>
        <div class="field-row">
            <div class="field">
                <label>Tier</label>
                <input type="number" min="0" max="6" @bind="_template.Tier" />
            </div>
            <div class="field">
                <label>Band</label>
                <input type="number" min="0" max="3" @bind="_template.Band" />
            </div>
        </div>
    </fieldset>

    <fieldset class="power-readout">
        <legend>Power (computed)</legend>
        <p class="hint">Computed from this item's worn stat bonuses via the power-budget oracle — the same math the in-game <code>power</code> inspector uses.</p>
        <p>Power: <strong>@ComputedPower</strong> &mdash; Tier/Band: <strong>@ComputedBand.Tier/@ComputedBand.Band</strong>
            @if (_template.Band != 0 && !WithinDriftTolerance)
            {
                <span class="warning-inline">(authored @_template.Tier/@_template.Band does not match computed @ComputedBand.Tier/@ComputedBand.Band)</span>
            }
        </p>
    </fieldset>

    @if (_errors.Count > 0)
    {
        <div class="error-box">
            <strong>Cannot save &mdash; validation failed:</strong>
            <ul>
                @foreach (var err in _errors)
                {
                    <li>@err</li>
                }
            </ul>
        </div>
    }

    @if (_warnings.Count > 0)
    {
        <div class="warning-box">
            <strong>Saved with notices:</strong>
            <ul>
                @foreach (var w in _warnings)
                {
                    <li>@w</li>
                }
            </ul>
        </div>
    }

    @if (_saved)
    {
        <p class="success">Saved <span class="mono">@_template.BlueprintId</span> to YAML.</p>
    }

    @if (!IsNew)
    {
        <div style="margin-top:1.5rem;padding-top:1rem;border-top:1px solid var(--border)">
            <button @onclick="SimulateVsReference" title="Simulates the last-saved version">Simulate vs reference</button>
        </div>
        <div style="margin-top:1.5rem;padding-top:1rem;border-top:1px solid var(--border)">
            @if (_confirmDelete)
            {
                <span class="confirm-inline">
                    <span>Permanently delete this item definition?</span>
                    <button class="danger-confirm" disabled="@_deleting" @onclick="ConfirmDelete">Yes, delete</button>
                    <button class="danger" @onclick="() => _confirmDelete = false">Cancel</button>
                </span>
            }
            else
            {
                <button class="danger" @onclick="() => _confirmDelete = true">Delete item</button>
            }
        </div>
    }

    <div class="actions">
        <button class="primary" disabled="@_saving" @onclick="Save">
            @(_saving ? "Saving..." : "Save")
        </button>
        <button disabled="@_saving" @onclick="SaveAndCreateNext" title="Saves, then starts a new definition carrying this one's authoring context forward">
            Save &amp; create next
        </button>
        <a class="cancel" href="">Back to browser</a>
    </div>
</div>
}

@code {
    [Parameter] public string? BlueprintId { get; set; }

    private static readonly ItemType[] AllItemTypes = Enum.GetValues<ItemType>();
    private static readonly WornSlot[] AllWornSlots = Enum.GetValues<WornSlot>();
    private static readonly ScoreId[] AllScoreIds = Enum.GetValues<ScoreId>();

    private ItemTemplate? _template;
    private bool _notFound;
    private bool _saving;
    private bool _saved;
    private bool _confirmDelete;
    private bool _deleting;
    // Set by "Save & create next": re-arms this page as a New form without a route change.
    private bool _forceNew;
    private bool _createNextPending;

    private IReadOnlyList<string> _errors = Array.Empty<string>();
    private IReadOnlyList<string> _warnings = Array.Empty<string>();
    private IReadOnlyList<ContentSummary> _areas = Array.Empty<ContentSummary>();
    private IReadOnlyList<ContentSummary> _allRooms = Array.Empty<ContentSummary>();
    private string _spawnAreaFilter = string.Empty;

    private IEnumerable<ContentSummary> SpawnRooms =>
        string.IsNullOrEmpty(_spawnAreaFilter)
            ? _allRooms
            : _allRooms.Where(r => r.AreaBlueprintId == _spawnAreaFilter);

    private void SetSpawnAreaFilter(string? value) =>
        _spawnAreaFilter = value ?? string.Empty;

    private bool IsNew => _forceNew || string.IsNullOrEmpty(BlueprintId);

    // Snapshot from the authored template via the shared IItemPowerProjectionSystem seam — never
    // IStatSystem.Get, since the editor operates on YAML templates with no live entity (see
    // docs/features/progression/power-budget-system.md).
    private int ComputedPower =>
        _template is null
            ? 0
            : PowerBudget.Estimate(ItemProjection.Project(_template), _template.Tier);

    private PowerBand ComputedBand => PowerBudget.Classify(ComputedPower);

    private bool WithinDriftTolerance =>
        _template is not null &&
        Math.Abs(
            StandardsRegistry.Tunables.GlobalBandIndex(_template.Tier, _template.Band) -
            StandardsRegistry.Tunables.GlobalBandIndex(ComputedBand.Tier, ComputedBand.Band)) <= StandardsRegistry.BandDriftTolerance;

    protected override void OnParametersSet()
    {
        _saved = false;
        _errors = Array.Empty<string>();
        _warnings = Array.Empty<string>();
        _confirmDelete = false;
        _forceNew = false;
        _focusPending = true;
        _areas = Catalog.List(ContentKind.Area);
        _allRooms = Catalog.List(ContentKind.Room);
        _spawnAreaFilter = string.Empty;

        if (IsNew)
        {
            _template = (ItemTemplate)Catalog.CreateNew(ContentKind.Item, "New Item").Template;
            _notFound = false;
        }
        else
        {
            var definition = Catalog.Load(ContentKind.Item, BlueprintId!);
            _template = definition?.Template as ItemTemplate;
            _notFound = _template is null;
            // Pre-select the area filter to match the current spawn room, if resolvable.
            if (_template is not null && !string.IsNullOrEmpty(_template.SpawnRoomBlueprintId))
            {
                var matchingRoom = _allRooms.FirstOrDefault(r => r.BlueprintId == _template.SpawnRoomBlueprintId);
                _spawnAreaFilter = matchingRoom?.AreaBlueprintId ?? string.Empty;
            }
        }
    }

    private void SetKeywords(string? raw)
    {
        if (_template is null) return;
        _template.Keywords = (raw ?? string.Empty)
            .Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries)
            .ToList();
    }

    private void SetWornSlot(WornSlot slot, bool include)
    {
        if (_template is null) return;
        if (include)
        {
            if (!_template.WornSlots.Contains(slot))
                _template.WornSlots.Add(slot);
        }
        else
        {
            _template.WornSlots.Remove(slot);
        }
    }

    private void AddBonus()
    {
        _template?.StatBonuses.Add(new EquipmentStatBonus(ScoreId.AttackPower, 0));
    }

    private void RemoveBonus(int index)
    {
        if (_template is null || index < 0 || index >= _template.StatBonuses.Count) return;
        _template.StatBonuses.RemoveAt(index);
    }

    private void SetBonusScore(int index, string? raw)
    {
        if (_template is null || index < 0 || index >= _template.StatBonuses.Count) return;
        if (Enum.TryParse<ScoreId>(raw, out var score))
            _template.StatBonuses[index] = _template.StatBonuses[index] with { TargetScore = score };
    }

    private void SetBonusMagnitude(int index, string? raw)
    {
        if (_template is null || index < 0 || index >= _template.StatBonuses.Count) return;
        if (int.TryParse(raw, out var magnitude))
            _template.StatBonuses[index] = _template.StatBonuses[index] with { Magnitude = magnitude };
    }

    // WithBlueprintId, never CreateNew - swapping in a fresh default would discard every other
    // field the author has already filled in on this form.
    private void OnBlueprintIdChanged(string newId)
    {
        if (_template is null) return;
        _template = (ItemTemplate)Catalog
            .WithBlueprintId(new ContentDefinition(ContentKind.Item, _template), newId).Template;
    }

    private void OnRenamed(ContentRenameResult result)
    {
        _warnings = result.Warnings;
        _errors = result.Errors;
        if (result.Success)
            Nav.NavigateTo($"item/{Uri.EscapeDataString(result.NewBlueprintId)}");
    }

    private async Task Save()
    {
        if (_template is null) return;

        _saving = true;
        _saved = false;
        _errors = Array.Empty<string>();
        _warnings = Array.Empty<string>();

        var result = IsNew
            ? await Catalog.CreateAsync(new ContentDefinition(ContentKind.Item, _template))
            : await Catalog.SaveAsync(new ContentDefinition(ContentKind.Item, _template));

        _saving = false;
        if (result.Success)
        {
            _saved = true;
            _warnings = result.Warnings;
            if (IsNew && !_createNextPending)
                Nav.NavigateTo($"item/{Uri.EscapeDataString(_template.BlueprintId)}");
        }
        else
        {
            _errors = result.Errors;
        }
    }


    /// <summary>
    /// Saves the current definition then re-arms the form as a New form seeded by
    /// <c>CreateNextFrom</c> - the catalog owns which fields carry forward (authoring policy plus
    /// kind dispatch, which a component may not hold; see docs/architecture/08-blazor.md).
    /// </summary>
    private async Task SaveAndCreateNext()
    {
        if (_template is null) return;

        var previous = new ContentDefinition(ContentKind.Item, _template);
        _createNextPending = true;
        await Save();
        _createNextPending = false;

        if (!_saved) return;

        _template = (ItemTemplate)Catalog.CreateNextFrom(previous, "New Item").Template;
        _forceNew = true;
        _saved = false;
        _focusPending = true;
    }

    // -- Keyboard-first authoring --------------------------------------------------
    // Enter saves, Esc returns to the browser. Multi-line fields stop keydown
    // propagation so Enter inside a textarea still inserts a newline.
    private bool _focusPending = true;
    private ElementReference _firstField;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!_focusPending || _template is null)
            return;

        _focusPending = false;
        try { await _firstField.FocusAsync(); }
        catch (Exception) { /* element not in the DOM this pass - harmless */ }
    }

    private async Task OnFormKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter" && !e.ShiftKey)
        {
            if (!_saving)
                await Save();
        }
        else if (e.Key == "Escape")
        {
            Nav.NavigateTo(string.Empty);
        }
    }

    private async Task ConfirmDelete()
    {
        if (_template is null) return;
        _deleting = true;
        _confirmDelete = false;
        try
        {
            await Catalog.DeleteAsync(ContentKind.Item, _template.BlueprintId);
            Nav.NavigateTo(string.Empty);
        }
        catch (Exception ex)
        {
            _errors = new[] { $"Delete failed: {ex.Message}" };
        }
        finally
        {
            _deleting = false;
        }
    }

    // Navigates to the Simulation page's prefilled composer (sim-3) — reads the last-saved
    // template, never the in-progress form edits (matches every other cross-page editor link).
    private void SimulateVsReference()
    {
        if (_template is null || IsNew) return;
        Nav.NavigateTo($"simulation?source=item&id={Uri.EscapeDataString(_template.BlueprintId)}");
    }
}
