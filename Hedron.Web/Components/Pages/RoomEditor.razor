@page "/room/new"
@page "/room/{BlueprintId}"
@using Hedron.Core
@using Hedron.Core.Modules.World.Templates
@inject IContentDefinitionCatalog Catalog
@inject NavigationManager Nav

<PageTitle>@(IsNew ? "New room" : "Edit room")</PageTitle>

<h1>@(IsNew ? "New room" : "Edit room")</h1>

@if (_notFound)
{
    <p class="error">No room definition with id <span class="mono">@BlueprintId</span> was found.</p>
    <a href="">Back to browser</a>
}
else if (_template is not null)
{
    <p class="mono blueprint-id">@_template.BlueprintId</p>

    <div class="field">
        <label>Name</label>
        <input @bind="_template.Name" />
    </div>

    <div class="field">
        <label>Area <span class="hint-inline">(target area blueprint id)</span></label>
        <select value="@_template.AreaId" @onchange="e => _template.AreaId = e.Value?.ToString() ?? string.Empty">
            <option value="">-- no area --</option>
            @foreach (var area in _areas)
            {
                <option value="@area.BlueprintId">@area.Name (@area.BlueprintId)</option>
            }
        </select>
    </div>

    <div class="field">
        <label>Description</label>
        <textarea rows="4" @bind="_template.Description"></textarea>
    </div>

    <fieldset class="exits">
        <legend>Exits</legend>
        @foreach (var dir in AllDirections)
        {
            var dir_ = dir;
            <div class="exit-picker">
                <label class="exit-label">@dir</label>
                <div class="room-picker">
                    <input class="room-picker-filter" placeholder="filter by name or id"
                           value="@_exitFilters[dir_]"
                           @oninput="e => SetExitFilter(dir_, e.Value?.ToString())" />
                    <select value="@ExitFor(dir_)"
                            @onchange="e => SetExit(dir_, e.Value?.ToString())">
                        <option value="">-- no exit --</option>
                        @foreach (var room in FilteredRoomsFor(dir_))
                        {
                            <option value="@room.BlueprintId">@room.Name (@room.BlueprintId)</option>
                        }
                    </select>
                </div>
            </div>
        }
        <p class="hint">Leave a direction with no exit selected to omit that exit.</p>
    </fieldset>

    <div class="bidir-toggle">
        <input type="checkbox" id="bidir" @bind="_bidirectional" />
        <label for="bidir">Write inverse exits (bidirectional) &mdash; also writes the reverse exit on each target room; skips with a warning if the target already has a different exit in that direction.</label>
    </div>

    @if (_errors.Count > 0)
    {
        <div class="error-box">
            <strong>Cannot save &mdash; validation failed:</strong>
            <ul>
                @foreach (var err in _errors)
                {
                    <li>@err</li>
                }
            </ul>
        </div>
    }

    @if (_warnings.Count > 0)
    {
        <div class="warning-box">
            <strong>Saved with notices:</strong>
            <ul>
                @foreach (var w in _warnings)
                {
                    <li>@w</li>
                }
            </ul>
        </div>
    }

    @if (_saved)
    {
        <p class="success">Saved <span class="mono">@_template.BlueprintId</span> to YAML.</p>
    }

    @if (!IsNew)
    {
        <div style="margin-top:1.5rem;padding-top:1rem;border-top:1px solid var(--border)">
            @if (_confirmDelete)
            {
                <span class="confirm-inline">
                    <span>Permanently delete this room definition?</span>
                    <button class="danger-confirm" disabled="@_deleting" @onclick="ConfirmDelete">Yes, delete</button>
                    <button class="danger" @onclick="() => _confirmDelete = false">Cancel</button>
                </span>
            }
            else
            {
                <button class="danger" @onclick="() => _confirmDelete = true">Delete room</button>
            }
        </div>
    }

    <div class="actions">
        <button class="primary" disabled="@_saving" @onclick="Save">
            @(_saving ? "Saving..." : "Save")
        </button>
        <a class="cancel" href="">Back to browser</a>
    </div>
}

@code {
    [Parameter] public string? BlueprintId { get; set; }

    private static readonly Direction[] AllDirections = Enum.GetValues<Direction>();

    private RoomTemplate? _template;
    private bool _notFound;
    private bool _saving;
    private bool _saved;
    private bool _bidirectional;
    private bool _confirmDelete;
    private bool _deleting;
    private IReadOnlyList<string> _errors = Array.Empty<string>();
    private IReadOnlyList<string> _warnings = Array.Empty<string>();
    private IReadOnlyList<ContentSummary> _areas = Array.Empty<ContentSummary>();
    private IReadOnlyList<ContentSummary> _rooms = Array.Empty<ContentSummary>();
    private Dictionary<Direction, string> _exitFilters = new();

    private bool IsNew => string.IsNullOrEmpty(BlueprintId);

    protected override void OnParametersSet()
    {
        _saved = false;
        _errors = Array.Empty<string>();
        _warnings = Array.Empty<string>();
        _confirmDelete = false;
        _bidirectional = false;
        _areas = Catalog.List(ContentKind.Area);
        _rooms = Catalog.List(ContentKind.Room);
        _exitFilters = AllDirections.ToDictionary(d => d, _ => string.Empty);

        if (IsNew)
        {
            _template = (RoomTemplate)Catalog.CreateNew(ContentKind.Room, "New Room").Template;
            _notFound = false;
        }
        else
        {
            var definition = Catalog.Load(ContentKind.Room, BlueprintId!);
            _template = definition?.Template as RoomTemplate;
            _notFound = _template is null;
        }
    }

    private string ExitFor(Direction dir) =>
        _template is not null && _template.Exits.TryGetValue(dir, out var target) ? target : string.Empty;

    private void SetExitFilter(Direction dir, string? value) =>
        _exitFilters[dir] = value ?? string.Empty;

    private IEnumerable<ContentSummary> FilteredRoomsFor(Direction dir)
    {
        var filter = _exitFilters.TryGetValue(dir, out var f) ? f : string.Empty;
        if (string.IsNullOrWhiteSpace(filter))
            return _rooms;
        return _rooms.Where(r =>
            r.Name.Contains(filter, StringComparison.OrdinalIgnoreCase) ||
            r.BlueprintId.Contains(filter, StringComparison.OrdinalIgnoreCase));
    }

    private void SetExit(Direction dir, string? raw)
    {
        if (_template is null) return;
        var target = raw?.Trim() ?? string.Empty;

        if (string.IsNullOrEmpty(target))
            _template.Exits.Remove(dir);
        else
            _template.Exits[dir] = target;
    }

    private async Task Save()
    {
        if (_template is null) return;

        _saving = true;
        _saved = false;
        _errors = Array.Empty<string>();
        _warnings = Array.Empty<string>();

        var result = _bidirectional
            ? await Catalog.SaveRoomAsync(_template, bidirectional: true)
            : await Catalog.SaveAsync(new ContentDefinition(ContentKind.Room, _template));

        _saving = false;
        if (result.Success)
        {
            _saved = true;
            _warnings = result.Warnings;
            if (IsNew)
                Nav.NavigateTo($"room/{Uri.EscapeDataString(_template.BlueprintId)}");
        }
        else
        {
            _errors = result.Errors;
        }
    }

    private async Task ConfirmDelete()
    {
        if (_template is null) return;
        _deleting = true;
        _confirmDelete = false;
        try
        {
            await Catalog.DeleteAsync(ContentKind.Room, _template.BlueprintId);
            Nav.NavigateTo(string.Empty);
        }
        catch (Exception ex)
        {
            _errors = new[] { $"Delete failed: {ex.Message}" };
        }
        finally
        {
            _deleting = false;
        }
    }
}
