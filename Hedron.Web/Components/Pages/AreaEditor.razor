@page "/area/new"
@page "/area/{BlueprintId}"
@using Hedron.Core.Modules.Aspects
@using Hedron.Core.Modules.World.Templates
@inject IContentDefinitionCatalog Catalog
@inject NavigationManager Nav

<PageTitle>@(IsNew ? "New area" : "Edit area")</PageTitle>

<h1>@(IsNew ? "New area" : "Edit area")</h1>

@if (_notFound)
{
    <p class="error">No area definition with id <span class="mono">@BlueprintId</span> was found.</p>
    <a href="">Back to browser</a>
}
else if (_template is not null)
{
<div class="editor-form" @onkeydown="OnFormKeyDown">
    <BlueprintIdField Kind="ContentKind.Area" IsNew="IsNew" BlueprintId="@_template.BlueprintId"
                       BlueprintIdChanged="OnBlueprintIdChanged" OnRenamed="OnRenamed" />

    @if (!IsNew)
    {
        <p><a href="@($"area/{Uri.EscapeDataString(_template.BlueprintId)}/grid")">Open grid editor</a></p>
    }

    <div class="field">
        <label>Name</label>
        <input @ref="_firstField" @bind="_template.Name" />
    </div>

    <div class="field">
        <label>Area id <span class="hint-inline">(blank = blueprint id)</span></label>
        <input @bind="_template.AreaId" />
    </div>

    <div class="field">
        <label>Description</label>
        <textarea rows="4" @bind="_template.Description" @onkeydown:stopPropagation="true"></textarea>
    </div>

    <div class="field-row">
        <div class="field">
            <label>Respawn rate</label>
            <input type="number" @bind="_template.RespawnRate" />
        </div>
        <div class="field checkbox">
            <label><input type="checkbox" @bind="_template.Pvp" /> PvP enabled</label>
        </div>
    </div>

    <fieldset class="affinities">
        <legend>Aspect affinities</legend>
        @foreach (var aspect in AllAspects)
        {
            <div class="field-row affinity" @key="aspect">
                <label class="affinity-label">@aspect</label>
                <input type="number" value="@AffinityFor(aspect)"
                       @onchange="e => SetAffinity(aspect, e.Value?.ToString())" />
            </div>
        }
        <p class="hint">Leave all at 0 to attach no affinities component.</p>
    </fieldset>

    @if (_errors.Count > 0)
    {
        <div class="error-box">
            <strong>Cannot save &mdash; validation failed:</strong>
            <ul>
                @foreach (var err in _errors)
                {
                    <li>@err</li>
                }
            </ul>
        </div>
    }

    @if (_warnings.Count > 0)
    {
        <div class="warning-box">
            <strong>Saved with notices:</strong>
            <ul>
                @foreach (var w in _warnings)
                {
                    <li>@w</li>
                }
            </ul>
        </div>
    }

    @if (_saved)
    {
        <p class="success">Saved <span class="mono">@_template.BlueprintId</span> to YAML.</p>
    }

    @if (!IsNew)
    {
        <div style="margin-top:1.5rem;padding-top:1rem;border-top:1px solid var(--border)">
            @if (_confirmDelete)
            {
                <span class="confirm-inline">
                    <span>Permanently delete this area definition?</span>
                    <button class="danger-confirm" disabled="@_deleting" @onclick="ConfirmDelete">Yes, delete</button>
                    <button class="danger" @onclick="() => _confirmDelete = false">Cancel</button>
                </span>
            }
            else
            {
                <button class="danger" @onclick="() => _confirmDelete = true">Delete area</button>
            }
        </div>
    }

    <div class="actions">
        <button class="primary" disabled="@_saving" @onclick="Save">
            @(_saving ? "Saving..." : "Save")
        </button>
        <button disabled="@_saving" @onclick="SaveAndCreateNext" title="Saves, then starts a new definition carrying this one's authoring context forward">
            Save &amp; create next
        </button>
        <a class="cancel" href="">Back to browser</a>
    </div>
</div>
}

@code {
    [Parameter] public string? BlueprintId { get; set; }

    private static readonly AspectId[] AllAspects = Enum.GetValues<AspectId>();

    private AreaTemplate? _template;
    private bool _notFound;
    private bool _saving;
    private bool _saved;
    private bool _confirmDelete;
    private bool _deleting;
    // Set by "Save & create next": re-arms this page as a New form without a route change.
    private bool _forceNew;
    private bool _createNextPending;
    private IReadOnlyList<string> _errors = Array.Empty<string>();
    private IReadOnlyList<string> _warnings = Array.Empty<string>();

    private bool IsNew => _forceNew || string.IsNullOrEmpty(BlueprintId);

    protected override void OnParametersSet()
    {
        _saved = false;
        _errors = Array.Empty<string>();
        _warnings = Array.Empty<string>();
        _confirmDelete = false;
        _forceNew = false;
        _focusPending = true;

        if (IsNew)
        {
            _template = (AreaTemplate)Catalog.CreateNew(ContentKind.Area, "New Area").Template;
            _notFound = false;
        }
        else
        {
            var definition = Catalog.Load(ContentKind.Area, BlueprintId!);
            _template = definition?.Template as AreaTemplate;
            _notFound = _template is null;
        }
    }

    private int AffinityFor(AspectId aspect) =>
        _template?.AspectAffinities is { } map && map.TryGetValue(aspect, out var weight) ? weight : 0;

    private void SetAffinity(AspectId aspect, string? raw)
    {
        if (_template is null) return;
        _ = int.TryParse(raw, out var weight);

        _template.AspectAffinities ??= new Dictionary<AspectId, int>();
        if (weight == 0)
            _template.AspectAffinities.Remove(aspect);
        else
            _template.AspectAffinities[aspect] = weight;

        if (_template.AspectAffinities.Count == 0)
            _template.AspectAffinities = null;
    }

    // WithBlueprintId, never CreateNew — swapping in a fresh default would discard every other
    // field the author has already filled in on this form.
    private void OnBlueprintIdChanged(string newId)
    {
        if (_template is null) return;
        _template = (AreaTemplate)Catalog
            .WithBlueprintId(new ContentDefinition(ContentKind.Area, _template), newId).Template;
    }

    private void OnRenamed(ContentRenameResult result)
    {
        _warnings = result.Warnings;
        _errors = result.Errors;
        if (result.Success)
            Nav.NavigateTo($"area/{Uri.EscapeDataString(result.NewBlueprintId)}");
    }

    private async Task Save()
    {
        if (_template is null) return;

        _saving = true;
        _saved = false;
        _errors = Array.Empty<string>();
        _warnings = Array.Empty<string>();

        var result = IsNew
            ? await Catalog.CreateAsync(new ContentDefinition(ContentKind.Area, _template))
            : await Catalog.SaveAsync(new ContentDefinition(ContentKind.Area, _template));

        _saving = false;
        if (result.Success)
        {
            _saved = true;
            _warnings = result.Warnings;
            // After a successful create, switch the URL to the edit route for the minted id —
            // unless a "Save & create next" is mid-flight, which re-arms this page in place.
            if (IsNew && !_createNextPending)
                Nav.NavigateTo($"area/{Uri.EscapeDataString(_template.BlueprintId)}");
        }
        else
        {
            _errors = result.Errors;
        }
    }


    /// <summary>
    /// Saves the current definition then re-arms the form as a New form seeded by
    /// <c>CreateNextFrom</c> — the catalog owns which fields carry forward (authoring policy plus
    /// kind dispatch, which a component may not hold; see docs/architecture/08-blazor.md).
    /// </summary>
    private async Task SaveAndCreateNext()
    {
        if (_template is null) return;

        var previous = new ContentDefinition(ContentKind.Area, _template);
        _createNextPending = true;
        await Save();
        _createNextPending = false;

        if (!_saved) return;

        _template = (AreaTemplate)Catalog.CreateNextFrom(previous, "New Area").Template;
        _forceNew = true;
        _saved = false;
        _focusPending = true;
    }

    // ── Keyboard-first authoring ────────────────────────────────────────────────
    // Enter saves, Esc returns to the browser. Multi-line fields stop keydown
    // propagation so Enter inside a textarea still inserts a newline.
    private ElementReference _firstField;
    private bool _focusPending = true;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!_focusPending || _template is null)
            return;

        _focusPending = false;
        try { await _firstField.FocusAsync(); }
        catch (Exception) { /* element not in the DOM this pass — harmless */ }
    }

    private async Task OnFormKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter" && !e.ShiftKey)
        {
            if (!_saving)
                await Save();
        }
        else if (e.Key == "Escape")
        {
            Nav.NavigateTo(string.Empty);
        }
    }

    private async Task ConfirmDelete()
    {
        if (_template is null) return;
        _deleting = true;
        _confirmDelete = false;
        try
        {
            await Catalog.DeleteAsync(ContentKind.Area, _template.BlueprintId);
            Nav.NavigateTo(string.Empty);
        }
        catch (Exception ex)
        {
            _errors = new[] { $"Delete failed: {ex.Message}" };
        }
        finally
        {
            _deleting = false;
        }
    }
}
