@page "/integrity"
@using Hedron.Core.Modules.BalanceInspection
@using Hedron.Core.Modules.BalanceInspection.Systems
@using Hedron.Web.Services
@inject ContentIntegritySweepService Sweeps
@inject ITemplateConformanceSystem Conformance

<PageTitle>Content integrity</PageTitle>

<h1>Content integrity</h1>

<p class="hint">
    Sweeps all on-disk YAML definitions for broken cross-references &mdash; targets that no
    longer exist. Fix each referrer in its editor before running <strong>Apply to live</strong>.
    This page is read-only, with one exception: the power-balance conformance fitter below writes
    YAML through the same validated <span class="mono">SaveAsync</span> path the editors use, and
    only after an explicit <strong>Apply</strong> click.
</p>

<div class="actions" style="margin-top:0.5rem">
    <button class="primary" disabled="@_sweeping" @onclick="Sweep">
        @(_sweeping ? "Sweeping..." : "Sweep now")
    </button>
</div>

@if (_swept)
{
    @if (_broken.Count == 0)
    {
        <p class="success" style="margin-top:1rem">No broken references found &mdash; all cross-definition links resolve.</p>
    }
    else
    {
        <p class="integrity-summary">Found <strong>@_broken.Count</strong> broken reference@(_broken.Count == 1 ? "" : "s").</p>

        <table class="grid">
            <thead>
                <tr>
                    <th>Kind</th>
                    <th>Source id</th>
                    <th>Field</th>
                    <th>Missing target</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var ref_ in _broken)
                {
                    <tr @key="(ref_.SourceKind, ref_.SourceBlueprintId, ref_.FieldLabel)">
                        <td><span class="kind-badge">@ref_.SourceKind</span></td>
                        <td class="mono">@ref_.SourceBlueprintId</td>
                        <td class="mono">@ref_.FieldLabel</td>
                        <td class="missing-id mono">@ref_.MissingTargetId</td>
                        <td>
                            <a href="@EditHref(ref_.SourceKind, ref_.SourceBlueprintId)">Edit</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
}

@if (_swept && _auditReport is not null)
{
    <h2 style="margin-top:2rem">Power balance &mdash; Tier&times;Band drift</h2>
    <p class="hint">
        Compares each item/mob's authored (Tier, Band) tag against the power-budget oracle's
        computed classification. Advisory only &mdash; never a build/reload/CI gate. Content with
        no authored band (Band 0) is excluded from drift, but still counted below.
    </p>

    @if (_auditReport.Drifted.Count == 0)
    {
        <p class="success">No content past the drift tolerance &mdash; every authored band is within range.</p>
    }
    else
    {
        <p class="integrity-summary">Found <strong>@_auditReport.Drifted.Count</strong> item@(_auditReport.Drifted.Count == 1 ? "" : "s")/mob@(_auditReport.Drifted.Count == 1 ? "" : "s") past the drift tolerance.</p>

        <div class="actions" style="margin-top:0">
            <button disabled="@_bulkConforming" @onclick="PreviewAllFlagged">Preview all flagged</button>
            <button class="primary" disabled="@_bulkConforming" @onclick="ApplyAllFlagged">
                @(_bulkConforming ? "Applying..." : "Apply all flagged")
            </button>
        </div>

        <table class="grid">
            <thead>
                <tr>
                    <th>Kind</th>
                    <th>Blueprint id</th>
                    <th>Authored</th>
                    <th>Computed</th>
                    <th>Drift</th>
                    <th></th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var entry in _auditReport.Drifted)
                {
                    <tr @key="entry.BlueprintId">
                        <td><span class="kind-badge">@entry.Kind</span></td>
                        <td class="mono">@entry.BlueprintId</td>
                        <td class="mono">@entry.AuthoredTier/@entry.AuthoredBand</td>
                        <td class="mono">@entry.ComputedTier/@entry.ComputedBand</td>
                        <td>@entry.Drift</td>
                        <td>
                            <a href="@(entry.Kind == BalanceAuditKind.Item ? "item" : "mob")/@Uri.EscapeDataString(entry.BlueprintId)">Edit</a>
                        </td>
                        <td>
                            @if (_appliedPendingReload.Contains(entry.BlueprintId))
                            {
                                <span class="pending-badge">applied &mdash; pending reload</span>
                            }
                            else
                            {
                                <button disabled="@_conforming.Contains(entry.BlueprintId)"
                                        @onclick="() => PreviewFit(entry.Kind, entry.BlueprintId)">
                                    @(_previews.ContainsKey(entry.BlueprintId) ? "Refresh preview" : "Preview fit")
                                </button>
                            }
                        </td>
                    </tr>
                    @if (_previews.TryGetValue(entry.BlueprintId, out var preview) && !_appliedPendingReload.Contains(entry.BlueprintId))
                    {
                        <tr class="conformance-preview-row">
                            <td colspan="7">
                                <div class="conformance-preview">
                                    <p>
                                        <span class="kind-badge">@preview.Status</span>
                                        @if (preview.Status == ConformanceStatus.NotFittable)
                                        {
                                            <span class="hint-inline">(@preview.NotFittableReason)</span>
                                        }
                                    </p>
                                    <p class="hint-inline">
                                        Power @preview.PowerBefore &rarr; @preview.PowerAfter
                                        &middot; Cell @preview.CellBefore.Tier/@preview.CellBefore.Band
                                        &rarr; @preview.CellAfter.Tier/@preview.CellAfter.Band
                                    </p>
                                    @if (preview.FieldChanges.Count > 0)
                                    {
                                        <table class="grid result">
                                            <thead><tr><th>Field</th><th>Before</th><th>After</th></tr></thead>
                                            <tbody>
                                                @foreach (var change in preview.FieldChanges)
                                                {
                                                    <tr @key="change.Field"><td>@change.Field</td><td>@change.Before</td><td>@change.After</td></tr>
                                                }
                                            </tbody>
                                        </table>
                                    }
                                    @if (preview.Status == ConformanceStatus.Fitted)
                                    {
                                        <div class="actions" style="margin-top:0.5rem">
                                            <button class="primary" disabled="@_conforming.Contains(entry.BlueprintId)"
                                                    @onclick="() => ApplyFit(entry.Kind, entry.BlueprintId)">
                                                @(_conforming.Contains(entry.BlueprintId) ? "Applying..." : "Apply")
                                            </button>
                                        </div>
                                    }
                                    @if (_applyResults.TryGetValue(entry.BlueprintId, out var applied) && !applied.Success)
                                    {
                                        <div class="error-box">
                                            <ul>
                                                @foreach (var err in applied.Errors)
                                                {
                                                    <li>@err</li>
                                                }
                                            </ul>
                                        </div>
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>

        @if (_conformanceError is not null)
        {
            <p class="error" style="margin-top:0.5rem">Conformance fit failed: @_conformanceError</p>
        }

        @if (_appliedPendingReload.Count > 0)
        {
            <p class="hint" style="margin-top:0.5rem">
                @_appliedPendingReload.Count applied and pending reload &mdash; run
                <a href="apply">Apply to live</a> to pick up the conformed templates, then re-sweep.
            </p>
        }
    }

    <p class="hint" style="margin-top:1rem">Content count by computed (Tier, Band) &mdash; "how much content exists at power level X":</p>
    <table class="grid">
        <thead>
            <tr>
                <th>Tier</th>
                <th>Band</th>
                <th>Count</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var bucket in _auditReport.BucketCounts.OrderBy(b => b.Key.Tier).ThenBy(b => b.Key.Band))
            {
                <tr @key="bucket.Key">
                    <td>@bucket.Key.Tier</td>
                    <td>@bucket.Key.Band</td>
                    <td>@bucket.Value</td>
                </tr>
            }
        </tbody>
    </table>
}

@if (_error is not null)
{
    <p class="error" style="margin-top:1rem">Sweep failed: @_error</p>
}

@code {
    private bool _sweeping;
    private bool _swept;
    private IReadOnlyList<BrokenReference> _broken = Array.Empty<BrokenReference>();
    private BalanceAuditReport? _auditReport;
    private string? _error;

    private readonly Dictionary<string, ConformancePreview> _previews = new();
    private readonly Dictionary<string, ConformanceApplyResult> _applyResults = new();
    private readonly HashSet<string> _appliedPendingReload = new();
    private readonly HashSet<string> _conforming = new();
    private bool _bulkConforming;
    private string? _conformanceError;

    // The two corpus sweeps run in ContentIntegritySweepService on a background thread; the page
    // only starts them and projects the snapshot. Nothing here blocks the circuit.
    protected override Task OnInitializedAsync() => RunSweep();

    private Task Sweep() => RunSweep();

    private async Task RunSweep()
    {
        var sweep = Sweeps.StartAsync();
        ApplySnapshot();      // in-progress state is observable immediately
        StateHasChanged();

        await sweep;

        ApplySnapshot();
    }

    private void ApplySnapshot()
    {
        var status = Sweeps.Snapshot();
        _sweeping = status.State == IntegritySweepState.Running;
        _swept = status.State == IntegritySweepState.Completed;
        _broken = status.Broken;
        _auditReport = status.AuditReport;
        _error = status.ErrorMessage;
    }

    // ── Conformance fitter (sim-5) — per-row preview/apply, thin caller of ITemplateConformanceSystem ──

    private void PreviewFit(BalanceAuditKind kind, string blueprintId)
    {
        _conformanceError = null;
        try
        {
            _previews[blueprintId] = Conformance.Preview(kind, blueprintId);
            _applyResults.Remove(blueprintId);
        }
        catch (Exception ex)
        {
            _conformanceError = ex.Message;
        }
    }

    private async Task ApplyFit(BalanceAuditKind kind, string blueprintId)
    {
        _conforming.Add(blueprintId);
        _conformanceError = null;
        try
        {
            var result = await Conformance.ApplyAsync(kind, blueprintId);
            _applyResults[blueprintId] = result;
            if (result.Success && result.Status == ConformanceStatus.Fitted)
                _appliedPendingReload.Add(blueprintId);
        }
        catch (Exception ex)
        {
            _conformanceError = ex.Message;
        }
        finally
        {
            _conforming.Remove(blueprintId);
        }
    }

    private void PreviewAllFlagged()
    {
        _conformanceError = null;
        try
        {
            foreach (var preview in Conformance.PreviewFlagged())
                _previews[preview.BlueprintId] = preview;
        }
        catch (Exception ex)
        {
            _conformanceError = ex.Message;
        }
    }

    private async Task ApplyAllFlagged()
    {
        _bulkConforming = true;
        _conformanceError = null;
        try
        {
            var bulk = await Conformance.ApplyFlaggedAsync();
            foreach (var result in bulk.Results)
            {
                _applyResults[result.BlueprintId] = result;
                if (result.Success && result.Status == ConformanceStatus.Fitted)
                    _appliedPendingReload.Add(result.BlueprintId);
            }
        }
        catch (Exception ex)
        {
            _conformanceError = ex.Message;
        }
        finally
        {
            _bulkConforming = false;
        }
    }

    private static string EditHref(ContentKind kind, string blueprintId)
    {
        var segment = kind switch
        {
            ContentKind.Area => "area",
            ContentKind.Room => "room",
            ContentKind.Item => "item",
            ContentKind.Mob  => "mob",
            _ => "area",
        };
        return $"{segment}/{Uri.EscapeDataString(blueprintId)}";
    }
}
