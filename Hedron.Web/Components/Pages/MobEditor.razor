@page "/mob/new"
@page "/mob/{BlueprintId}"
@using Hedron.Core.ECS.Components
@using Hedron.Core.Modules.BalanceInspection
@using Hedron.Core.Modules.BalanceInspection.Systems
@using Hedron.Core.Modules.Economy
@using Hedron.Core.Modules.Mobs.Templates
@using Hedron.Core.Modules.Shopping.Components
@using Hedron.Core.Modules.Stats
@using Hedron.Core.Systems
@inject IContentDefinitionCatalog Catalog
@inject NavigationManager Nav
@* The computed-power readout is one domain-tier composition (projection + oracle + drift tolerance),
   shared with the authoring API's power endpoint — this page renders it, it does not compose it. *@
@inject IMobPowerReadoutSystem PowerReadout

<PageTitle>@(IsNew ? "New mob" : "Edit mob")</PageTitle>

<h1>@(IsNew ? "New mob" : "Edit mob")</h1>

@if (_notFound)
{
    <p class="error">No mob definition with id <span class="mono">@BlueprintId</span> was found.</p>
    <a href="">Back to browser</a>
}
else if (_template is not null)
{
<div class="editor-form" @onkeydown="OnFormKeyDown">
    <BlueprintIdField Kind="ContentKind.Mob" IsNew="IsNew" BlueprintId="@_template.BlueprintId"
                       BlueprintIdChanged="OnBlueprintIdChanged" OnRenamed="OnRenamed" />

    <div class="field">
        <label>Name</label>
        <input @ref="_firstField" @bind="_template.Name" />
    </div>

    <div class="field">
        <label>Description</label>
        <textarea rows="4" @bind="_template.Description" @onkeydown:stopPropagation="true"></textarea>
    </div>

    <div class="field-row">
        <div class="field">
            <label>Mob type</label>
            <select @bind="_template.MobType">
                @foreach (var type in AllMobTypes)
                {
                    <option value="@type">@type</option>
                }
            </select>
        </div>
        <div class="field">
            <label>Level</label>
            <input type="number" @bind="_template.Level" />
        </div>
    </div>

    <fieldset class="spawn-location">
        <legend>Spawn location</legend>
        <p class="hint">Select an area to narrow the room list, then pick the spawn room.</p>
        <div class="field-row">
            <div class="field">
                <label>Area</label>
                <select value="@_spawnAreaFilter" @onchange="e => SetSpawnAreaFilter(e.Value?.ToString())">
                    <option value="">All areas</option>
                    @foreach (var area in _areas)
                    {
                        <option @key="area.BlueprintId" value="@area.BlueprintId">@area.Name</option>
                    }
                </select>
            </div>
            <div class="field">
                <label>Room <span class="hint-inline">(blank = no spawn location)</span></label>
                <select value="@_template.SpawnRoomBlueprintId"
                        @onchange="e => _template.SpawnRoomBlueprintId = e.Value?.ToString() ?? string.Empty">
                    <option value="">-- no spawn room --</option>
                    @foreach (var room in SpawnRooms)
                    {
                        <option @key="room.BlueprintId" value="@room.BlueprintId">@room.Name (@room.BlueprintId)</option>
                    }
                </select>
            </div>
        </div>
    </fieldset>

    <fieldset class="keywords">
        <legend>Keywords</legend>
        <p class="hint">Comma-separated keyword aliases used to reference the mob in game.</p>
        <input class="csv" placeholder="goblin, guard, sentry"
               value="@string.Join(", ", _template.Keywords)"
               @onchange="e => SetKeywords(e.Value?.ToString())" />
    </fieldset>

    <fieldset class="attributes">
        <legend>Attributes</legend>
        <div class="field-row">
            <div class="field">
                <label>Mind</label>
                <input type="number" @bind="_template.Mind" />
            </div>
            <div class="field">
                <label>Body</label>
                <input type="number" @bind="_template.Body" />
            </div>
            <div class="field">
                <label>Spirit</label>
                <input type="number" @bind="_template.Spirit" />
            </div>
            <div class="field">
                <label>Attunement</label>
                <input type="number" @bind="_template.Attunement" />
            </div>
        </div>
        <p class="hint">Leave an attribute at 0 to use the apply-time default.</p>
    </fieldset>

    <fieldset class="pools">
        <legend>Pools</legend>
        <div class="field-row">
            <div class="field">
                <label>Max HP</label>
                <input type="number" @bind="_template.MaxHp" />
            </div>
            <div class="field">
                <label>Max mana</label>
                <input type="number" @bind="_template.MaxMana" />
            </div>
            <div class="field">
                <label>Max stamina</label>
                <input type="number" @bind="_template.MaxStamina" />
            </div>
            <div class="field">
                <label>Max astra</label>
                <input type="number" @bind="_template.MaxAstra" />
            </div>
        </div>
        <p class="hint">Leave a pool at 0 to use the apply-time default.</p>
    </fieldset>

    <fieldset class="protection">
        <legend>Protection</legend>
        <p class="hint">Flags prevent this mob from being attacked or affected. Leave both unchecked for no protection (opt-in default).</p>
        <div class="field-row">
            <div class="field">
                <label>
                    <input type="checkbox"
                           checked="@_template.Protection.HasFlag(ProtectionFlags.Untargetable)"
                           @onchange="e => ToggleProtectionFlag(ProtectionFlags.Untargetable, (bool)(e.Value ?? false))" />
                    Untargetable (cannot be attacked)
                </label>
            </div>
            <div class="field">
                <label>
                    <input type="checkbox"
                           checked="@_template.Protection.HasFlag(ProtectionFlags.EffectImmune)"
                           @onchange="e => ToggleProtectionFlag(ProtectionFlags.EffectImmune, (bool)(e.Value ?? false))" />
                    Effect-immune (rejects all effects)
                </label>
            </div>
        </div>
    </fieldset>

    <fieldset class="ascension">
        <legend>Ascension</legend>
        <p class="hint">Tier (0-6, mechanical Ascension scalar) &times; Band (0-3, purely descriptive; 0 = unbanded/default). Mechanical threat is emergent from the tier baseline &mdash; Band is a content tag, not a power multiplier.</p>
        <div class="field-row">
            <div class="field">
                <label>Tier</label>
                <input type="number" min="0" max="6" @bind="_template.Tier" />
            </div>
            <div class="field">
                <label>Band</label>
                <input type="number" min="0" max="3" @bind="_template.Band" />
            </div>
        </div>
    </fieldset>

    <fieldset class="progression">
        <legend>Progression</legend>
        <p class="hint">Per-mob experience scale for kills of this mob. 1.0 is the default; 0 means killing it awards no experience. Multiplies on top of the global scalar and the anti-grind power ratio.</p>
        <div class="field-row">
            <div class="field">
                <label>XP scale</label>
                <input type="number" min="0" step="0.05" @bind="_template.XpScale" />
            </div>
        </div>
    </fieldset>

    <fieldset class="power-readout">
        <legend>Power (computed)</legend>
        <p class="hint">Computed from this mob's authored attributes/pools + tier via the power-budget oracle — the same math the in-game <code>power</code> inspector uses.</p>
        @{
            var readout = PowerReadout.Read(_template);
        }
        <p>Power: <strong>@readout.Power</strong> &mdash; Tier/Band: <strong>@readout.Computed.Tier/@readout.Computed.Band</strong>
            @if (readout.AuthoredTargetRange is { } target)
            {
                <span class="hint-inline">(authored @readout.AuthoredTier/@readout.AuthoredBand targets @target.MinPower&ndash;@target.MaxPower)</span>
            }
            @if (readout.DriftsFromAuthoredCell)
            {
                <span class="warning-inline">(authored @readout.AuthoredTier/@readout.AuthoredBand does not match computed @readout.Computed.Tier/@readout.Computed.Band)</span>
            }
        </p>
    </fieldset>

    <fieldset class="currency-loot">
        <legend>Currency loot</legend>
        <p class="hint">Base units (copper). 100 = 1 gold. Leave both at 0 for no currency drop (opt-in default).</p>
        <div class="field-row">
            <div class="field">
                <label>Coin min (copper)</label>
                <input type="number" min="0"
                       value="@GetCoinLootMin()"
                       @onchange="e => SetCoinLootMin(e.Value?.ToString())" />
            </div>
            <div class="field">
                <label>Coin max (copper)</label>
                <input type="number" min="0"
                       value="@GetCoinLootMax()"
                       @onchange="e => SetCoinLootMax(e.Value?.ToString())" />
            </div>
        </div>
    </fieldset>

    <fieldset class="shop">
        <legend>Shop</legend>
        <p class="hint">Configure this mob as a shopkeeper. Leave unchecked for a non-trading mob (opt-in default).</p>
        <div class="field">
            <label>
                <input type="checkbox"
                       checked="@_template.IsShop"
                       @onchange="e => _template.IsShop = (bool)(e.Value ?? false)" />
                Is shopkeeper
            </label>
        </div>
        @if (_template.IsShop)
        {
            <div class="field-row">
                <div class="field">
                    <label>Till seed (base units, 0 = global default)</label>
                    <input type="number" min="0"
                           value="@_template.ShopTillSeed"
                           @onchange="e => SetTillSeed(e.Value?.ToString())" />
                </div>
            </div>
            <div class="field">
                <p class="hint">Base stock: blueprint ids and quantities spawned into inventory on each startup. One row per item type.</p>
                @for (var i = 0; i < _template.ShopBaseStock.Count; i++)
                {
                    var idx = i;
                    <div class="field-row" @key="idx">
                        <div class="field">
                            <label>Blueprint id</label>
                            <input value="@_template.ShopBaseStock[idx].BlueprintId"
                                   @onchange="e => _template.ShopBaseStock[idx].BlueprintId = e.Value?.ToString() ?? string.Empty" />
                        </div>
                        <div class="field">
                            <label>Qty</label>
                            <input type="number" min="1"
                                   value="@_template.ShopBaseStock[idx].Quantity"
                                   @onchange="e => SetBaseStockQty(idx, e.Value?.ToString())" />
                        </div>
                        <div class="field">
                            <button @onclick="() => RemoveBaseStockRow(idx)">Remove</button>
                        </div>
                    </div>
                }
                <button @onclick="AddBaseStockRow">+ Add stock row</button>
            </div>
        }
    </fieldset>

    @if (_errors.Count > 0)
    {
        <div class="error-box">
            <strong>Cannot save &mdash; validation failed:</strong>
            <ul>
                @foreach (var err in _errors)
                {
                    <li>@err</li>
                }
            </ul>
        </div>
    }

    @if (_warnings.Count > 0)
    {
        <div class="warning-box">
            <strong>Saved with notices:</strong>
            <ul>
                @foreach (var w in _warnings)
                {
                    <li>@w</li>
                }
            </ul>
        </div>
    }

    @if (_saved)
    {
        <p class="success">Saved <span class="mono">@_template.BlueprintId</span> to YAML.</p>
    }

    @if (!IsNew)
    {
        <div style="margin-top:1.5rem;padding-top:1rem;border-top:1px solid var(--border)">
            <button @onclick="SimulateVsReference" title="Simulates the last-saved version">Simulate vs reference</button>
        </div>
        <div style="margin-top:1.5rem;padding-top:1rem;border-top:1px solid var(--border)">
            @if (_confirmDelete)
            {
                <span class="confirm-inline">
                    <span>Permanently delete this mob definition?</span>
                    <button class="danger-confirm" disabled="@_deleting" @onclick="ConfirmDelete">Yes, delete</button>
                    <button class="danger" @onclick="() => _confirmDelete = false">Cancel</button>
                </span>
            }
            else
            {
                <button class="danger" @onclick="() => _confirmDelete = true">Delete mob</button>
            }
        </div>
    }

    <div class="actions">
        <button class="primary" disabled="@_saving" @onclick="Save">
            @(_saving ? "Saving..." : "Save")
        </button>
        <button disabled="@_saving" @onclick="SaveAndCreateNext" title="Saves, then starts a new definition carrying this one's authoring context forward">
            Save &amp; create next
        </button>
        <a class="cancel" href="">Back to browser</a>
    </div>
</div>
}

@code {
    [Parameter] public string? BlueprintId { get; set; }

    private static readonly MobType[] AllMobTypes = Enum.GetValues<MobType>();

    private MobTemplate? _template;
    private bool _notFound;
    private bool _saving;
    private bool _saved;
    private bool _confirmDelete;
    private bool _deleting;
    // Set by "Save & create next": re-arms this page as a New form without a route change.
    private bool _forceNew;
    private bool _createNextPending;
    private IReadOnlyList<string> _errors = Array.Empty<string>();
    private IReadOnlyList<string> _warnings = Array.Empty<string>();
    private IReadOnlyList<ContentSummary> _areas = Array.Empty<ContentSummary>();
    private IReadOnlyList<ContentSummary> _allRooms = Array.Empty<ContentSummary>();
    private string _spawnAreaFilter = string.Empty;

    private IEnumerable<ContentSummary> SpawnRooms =>
        string.IsNullOrEmpty(_spawnAreaFilter)
            ? _allRooms
            : _allRooms.Where(r => r.AreaBlueprintId == _spawnAreaFilter);

    private void SetSpawnAreaFilter(string? value) =>
        _spawnAreaFilter = value ?? string.Empty;

    private bool IsNew => _forceNew || string.IsNullOrEmpty(BlueprintId);

    protected override void OnParametersSet()
    {
        _saved = false;
        _errors = Array.Empty<string>();
        _warnings = Array.Empty<string>();
        _confirmDelete = false;
        _forceNew = false;
        _focusPending = true;
        _areas = Catalog.List(ContentKind.Area);
        _allRooms = Catalog.List(ContentKind.Room);
        _spawnAreaFilter = string.Empty;

        if (IsNew)
        {
            _template = (MobTemplate)Catalog.CreateNew(ContentKind.Mob, "New Mob").Template;
            _notFound = false;
        }
        else
        {
            var definition = Catalog.Load(ContentKind.Mob, BlueprintId!);
            _template = definition?.Template as MobTemplate;
            _notFound = _template is null;
            // Pre-select the area filter to match the current spawn room, if resolvable.
            if (_template is not null && !string.IsNullOrEmpty(_template.SpawnRoomBlueprintId))
            {
                var matchingRoom = _allRooms.FirstOrDefault(r => r.BlueprintId == _template.SpawnRoomBlueprintId);
                _spawnAreaFilter = matchingRoom?.AreaBlueprintId ?? string.Empty;
            }
        }
    }

    private void SetKeywords(string? raw)
    {
        if (_template is null) return;
        _template.Keywords = (raw ?? string.Empty)
            .Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries)
            .ToList();
    }

    // ── Protection helpers ────────────────────────────────────────────────────

    private void ToggleProtectionFlag(ProtectionFlags flag, bool on)
    {
        if (_template is null) return;
        if (on)
            _template.Protection |= flag;
        else
            _template.Protection &= ~flag;
    }

    // ── Currency loot helpers ─────────────────────────────────────────────────

    private int GetCoinLootMin() =>
        _template is not null && _template.CurrencyLoot.TryGetValue(CurrencyId.Coin, out var r)
            ? r.Min : 0;

    private int GetCoinLootMax() =>
        _template is not null && _template.CurrencyLoot.TryGetValue(CurrencyId.Coin, out var r)
            ? r.Max : 0;

    private void SetCoinLootMin(string? raw)
    {
        if (_template is null) return;
        if (!int.TryParse(raw, out var v) || v < 0) v = 0;
        _template.CurrencyLoot.TryGetValue(CurrencyId.Coin, out var existing);
        _template.CurrencyLoot[CurrencyId.Coin] = (v, existing.Max);
    }

    private void SetCoinLootMax(string? raw)
    {
        if (_template is null) return;
        if (!int.TryParse(raw, out var v) || v < 0) v = 0;
        _template.CurrencyLoot.TryGetValue(CurrencyId.Coin, out var existing);
        _template.CurrencyLoot[CurrencyId.Coin] = (existing.Min, v);
    }

    // WithBlueprintId, never CreateNew - swapping in a fresh default would discard every other
    // field the author has already filled in on this form.
    private void OnBlueprintIdChanged(string newId)
    {
        if (_template is null) return;
        _template = (MobTemplate)Catalog
            .WithBlueprintId(new ContentDefinition(ContentKind.Mob, _template), newId).Template;
    }

    private void OnRenamed(ContentRenameResult result)
    {
        _warnings = result.Warnings;
        _errors = result.Errors;
        if (result.Success)
            Nav.NavigateTo($"mob/{Uri.EscapeDataString(result.NewBlueprintId)}");
    }

    private async Task Save()
    {
        if (_template is null) return;

        _saving = true;
        _saved = false;
        _errors = Array.Empty<string>();
        _warnings = Array.Empty<string>();

        var result = IsNew
            ? await Catalog.CreateAsync(new ContentDefinition(ContentKind.Mob, _template))
            : await Catalog.SaveAsync(new ContentDefinition(ContentKind.Mob, _template));

        _saving = false;
        if (result.Success)
        {
            _saved = true;
            _warnings = result.Warnings;
            if (IsNew && !_createNextPending)
                Nav.NavigateTo($"mob/{Uri.EscapeDataString(_template.BlueprintId)}");
        }
        else
        {
            _errors = result.Errors;
        }
    }

    // ── Shop helpers ──────────────────────────────────────────────────────────

    private void SetTillSeed(string? raw)
    {
        if (_template is null) return;
        if (!long.TryParse(raw, out var v) || v < 0) v = 0;
        _template.ShopTillSeed = v;
    }

    private void AddBaseStockRow()
    {
        _template?.ShopBaseStock.Add(new ShopStockRow { BlueprintId = string.Empty, Quantity = 1 });
    }

    private void RemoveBaseStockRow(int index)
    {
        if (_template is null || index < 0 || index >= _template.ShopBaseStock.Count) return;
        _template.ShopBaseStock.RemoveAt(index);
    }

    private void SetBaseStockQty(int index, string? raw)
    {
        if (_template is null || index < 0 || index >= _template.ShopBaseStock.Count) return;
        if (!int.TryParse(raw, out var v) || v < 1) v = 1;
        _template.ShopBaseStock[index].Quantity = v;
    }


    /// <summary>
    /// Saves the current definition then re-arms the form as a New form seeded by
    /// <c>CreateNextFrom</c> - the catalog owns which fields carry forward (authoring policy plus
    /// kind dispatch, which a component may not hold; see docs/architecture/08-blazor.md).
    /// </summary>
    private async Task SaveAndCreateNext()
    {
        if (_template is null) return;

        var previous = new ContentDefinition(ContentKind.Mob, _template);
        _createNextPending = true;
        await Save();
        _createNextPending = false;

        if (!_saved) return;

        _template = (MobTemplate)Catalog.CreateNextFrom(previous, "New Mob").Template;
        _forceNew = true;
        _saved = false;
        _focusPending = true;
    }

    // -- Keyboard-first authoring --------------------------------------------------
    // Enter saves, Esc returns to the browser. Multi-line fields stop keydown
    // propagation so Enter inside a textarea still inserts a newline.
    private ElementReference _firstField;
    private bool _focusPending = true;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!_focusPending || _template is null)
            return;

        _focusPending = false;
        try { await _firstField.FocusAsync(); }
        catch (Exception) { /* element not in the DOM this pass - harmless */ }
    }

    private async Task OnFormKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter" && !e.ShiftKey)
        {
            if (!_saving)
                await Save();
        }
        else if (e.Key == "Escape")
        {
            Nav.NavigateTo(string.Empty);
        }
    }

    private async Task ConfirmDelete()
    {
        if (_template is null) return;
        _deleting = true;
        _confirmDelete = false;
        try
        {
            await Catalog.DeleteAsync(ContentKind.Mob, _template.BlueprintId);
            Nav.NavigateTo(string.Empty);
        }
        catch (Exception ex)
        {
            _errors = new[] { $"Delete failed: {ex.Message}" };
        }
        finally
        {
            _deleting = false;
        }
    }

    // Navigates to the Simulation page's prefilled composer (sim-3) — reads the last-saved
    // template, never the in-progress form edits (matches every other cross-page editor link).
    private void SimulateVsReference()
    {
        if (_template is null || IsNew) return;
        Nav.NavigateTo($"simulation?source=mob&id={Uri.EscapeDataString(_template.BlueprintId)}");
    }
}
