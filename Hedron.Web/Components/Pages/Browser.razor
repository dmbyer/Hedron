@page "/"
@inject IContentDefinitionCatalog Catalog
@inject NavigationManager Nav

<PageTitle>Browse content</PageTitle>

<h1>Content browser</h1>

<p class="hint">
    Lists the authored YAML definitions on disk. Areas and rooms are editable; items and mobs are
    list/read-only in this release.
</p>

<div class="kind-tabs">
    @foreach (var k in AllKinds)
    {
        <button class="tab @(k == _kind ? "active" : "")" @onclick="() => SelectKind(k)">
            @k (@CountFor(k))
        </button>
    }
</div>

<div class="kind-toolbar">
    @if (IsEditable(_kind))
    {
        <button class="primary" @onclick="CreateNew">+ New @_kind</button>
    }
    else
    {
        <span class="readonly-note">@_kind editing arrives in a later release (read-only here).</span>
    }
</div>

@if (_summaries.Count == 0)
{
    <p class="empty">No @_kind definitions found.</p>
}
else
{
    <table class="grid">
        <thead>
            <tr>
                <th>Blueprint id</th>
                <th>Name</th>
                <th>Description</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var s in _summaries)
            {
                <tr>
                    <td class="mono">@s.BlueprintId</td>
                    <td>@s.Name</td>
                    <td class="desc">@Short(s.Description)</td>
                    <td>
                        @if (IsEditable(_kind))
                        {
                            <a href="@EditHref(s.BlueprintId)">Edit</a>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
}

@code {
    private static readonly ContentKind[] AllKinds =
        { ContentKind.Area, ContentKind.Room, ContentKind.Item, ContentKind.Mob };

    private ContentKind _kind = ContentKind.Area;
    private IReadOnlyList<ContentSummary> _summaries = Array.Empty<ContentSummary>();

    protected override void OnInitialized() => Reload();

    private void SelectKind(ContentKind kind)
    {
        _kind = kind;
        Reload();
    }

    private void Reload() => _summaries = Catalog.List(_kind);

    private int CountFor(ContentKind kind) => Catalog.List(kind).Count;

    private static bool IsEditable(ContentKind kind) =>
        kind is ContentKind.Area or ContentKind.Room;

    private void CreateNew() =>
        Nav.NavigateTo(_kind == ContentKind.Area ? "area/new" : "room/new");

    private string EditHref(string blueprintId) =>
        _kind == ContentKind.Area
            ? $"area/{Uri.EscapeDataString(blueprintId)}"
            : $"room/{Uri.EscapeDataString(blueprintId)}";

    private static string Short(string description) =>
        string.IsNullOrEmpty(description) || description.Length <= 80
            ? description
            : description[..77] + "...";
}
